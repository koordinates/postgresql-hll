#!/bin/sh
set -e

# Post-installation script for postgresql-hll

case "$1" in
    configure)
        # Nothing special needed for hll extension
        # The extension files are already in place
        echo "postgresql-hll extension installed successfully."
        echo "To use it, connect to your database and run: CREATE EXTENSION hll;"
        ;;

    abort-upgrade|abort-remove|abort-deconfigure)
        ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

exit 0